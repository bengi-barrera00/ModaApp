<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.ModaApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/rosa_oscuro</item>
        <item name="colorPrimaryVariant">@color/rosa</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorSecondary">@color/rosa_oscuro</item>
        <item name="colorOnSecondary">@color/blanco</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <style name="Theme.ModaApp" parent="Base.Theme.ModaApp" />

    <style name="Campo" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/blanco</item>
        <item name="boxStrokeColor">@color/rosa_oscuro</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="BotonPrimario" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BotonSecundario" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="strokeColor">@color/rosa_oscuro</item>
        <item name="android:textColor">@color/rosa_oscuro</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>