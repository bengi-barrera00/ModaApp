<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="84dp" android:layout_height="84dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="64dp"
        android:background="@drawable/bg_logo" android:gravity="center"
        android:text="@string/ini_logo" android:textColor="@color/rosa_oscuro"
        android:textSize="40sp" android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
        android:text="@string/app_name" android:textColor="@color/negro"
        android:textSize="30sp" android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/subtitulo" android:textColor="@color/gris_texto" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilUsuario" style="@style/Campo"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="32dp"
        android:hint="@string/usuario">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUsuario"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilClave" style="@style/Campo"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="12dp"
        android:hint="@string/clave" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etClave"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnIngresar" style="@style/BotonPrimario"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="20dp"
        android:text="@string/ingresar" />

    <Button
        android:id="@+id/btnCatalogo" style="@style/BotonSecundario"
        android:layout_width="match_parent" android:layout_height="56dp"
        android:layout_marginHorizontal="24dp" android:layout_marginTop="10dp"
        android:text="@string/ver_catalogo" />

    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="16dp"
        android:text="@string/prueba" android:textColor="@color/gris_texto" />
</LinearLayout>