<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/blanco"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/borde"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="64dp" android:layout_height="64dp"
            android:background="@drawable/bg_foto" android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/negro" android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvDetalle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textColor="@color/gris_texto" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubtotal"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top" android:textColor="@color/rosa_oscuro"
            android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>