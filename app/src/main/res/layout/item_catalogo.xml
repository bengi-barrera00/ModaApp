<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/blanco"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/borde"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="10dp">

        <ImageView
            android:id="@+id/ivFoto"
            android:layout_width="match_parent" android:layout_height="130dp"
            android:background="@drawable/bg_foto" android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvModelo"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="@color/negro"
            android:textSize="16sp" android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTalla"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/gris_texto" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvPrecio"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="@color/rosa_oscuro"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView
                android:id="@+id/btnAgregar"
                android:layout_width="36dp" android:layout_height="36dp"
                android:background="@drawable/bg_boton_mas" android:gravity="center"
                android:text="@string/mas" android:textColor="@color/blanco"
                android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>